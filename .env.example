# 复制此文件为 .env，填入真实值
# .env 已在 .gitignore 中，禁止提交真实密钥

# LLM
LLM_API_KEY=<YOUR_OPENAI_API_KEY>
LLM_MODEL=gpt-4o

# 认证（随机生成，最少 32 位）
AUTH_JWT_SECRET=your-super-secret-jwt-key-at-least-32-chars

# 数据库（Docker Compose 本地开发时使用默认值即可）
POSTGRES_HOST_PORT=15432
DATABASE_URL=postgres://mosaic:mosaic@localhost:15432/mosaic?sslmode=disable

# 对象存储（Docker Compose 本地开发时使用默认值即可）
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=mosaic
STORAGE_SECRET_KEY=mosaic_secret
STORAGE_BUCKET=mosaic-dev
